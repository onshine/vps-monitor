#!/bin/sh
set -eu
SERVICE=vps-monitor;CONFIG=/etc/vps-monitor.env;DATA=/var/lib/vps-monitor;RUNTIME=$DATA/runtime.log;TTY=/dev/tty
BASE_CMDLINE='vite build,npm run build,npm install,npm ci,docker build,apt-get,dpkg,mysqldump'
BASE_CONTAINERS='alist-tvbox,xiaoya-tvbox'
# 历史版本写入过的默认豁免名单。仅当配置与其中之一完全一致（即用户从未修改）时，
# 升级才会替换为当前默认值；用户改过的名单一律原样保留。
LEGACY_CMDLINE_1='vite build,npm run build,npm install,yarn build,yarn install,pnpm build,pnpm install,webpack,rollup,esbuild,tsc,next build,nuxt build,cargo build,go build,mvn ,gradle,make ,cmake,gcc ,g++ ,rustc,pip install,poetry install,composer install,bundle install,docker build,apt-get,apt ,dnf ,yum ,dpkg,rsync,tar ,unzip,7z,borg,restic,duplicity,mysqldump,pg_dump'
addct(){ cur=${AUTO_ACTION_PROTECTED_CONTAINERS:-};case "$cur" in ''|,*) cur=$BASE_CONTAINERS;; esac;setval AUTO_ACTION_PROTECTED_CONTAINERS "$cur,$1";}
addcmd(){ cur=${AUTO_ACTION_PROTECTED_CMDLINE:-};case "$cur" in ''|,*) cur=$BASE_CMDLINE;; esac;setval AUTO_ACTION_PROTECTED_CMDLINE "$cur,$1";}
if [ -t 1 ];then G='\033[1;32m';Y='\033[1;33m';R='\033[1;31m';N='\033[0m';else G=;Y=;R=;N=;fi
say(){ printf '%b%s%b\n' "$1" "$2" "$N";};ask(){ printf '%b%s%b' "$1" "$2" "$N">"$TTY";IFS= read -r REPLY<"$TTY"||REPLY=;}
need_root(){ [ "$(id -u)" = 0 ]||{ say "$R" '请使用 sudo。';exit 1;};}
load(){
 # 安全解析：不使用 source，避免配置值中的空格或元字符被 shell 当命令执行
 while IFS= read -r ln;do
  case "$ln" in ''|\#*) continue;; esac
  case "$ln" in *=*) ;; *) continue;; esac
  k=${ln%%=*};v=${ln#*=}
  case "$k" in [A-Z]*) ;; *) continue;; esac
  v=${v#\"};v=${v%\"};v=${v#\'};v=${v%\'}
  eval "export $k=\$v"
 done <"$CONFIG"
}
repair(){
 # 修复历史版本写入的未加引号值，防止 shell 解析错误
 need_root
 tmp=$(mktemp);flag=$(mktemp)
 while IFS= read -r ln;do
  case "$ln" in
   ''|\#*) printf '%s\n' "$ln">>"$tmp";continue;;
  esac
  case "$ln" in *=*) ;; *) printf '%s\n' "$ln">>"$tmp";continue;; esac
  k=${ln%%=*};v=${ln#*=}
  case "$k" in [A-Z]*) ;; *) printf '%s\n' "$ln">>"$tmp";continue;; esac
  case "$v" in \"*\") printf '%s\n' "$ln">>"$tmp";continue;; esac
  printf '%s="%s"\n' "$k" "$v">>"$tmp";echo 1>>"$flag"
 done <"$CONFIG"
 if [ -s "$flag" ];then cat "$tmp">"$CONFIG";chmod 600 "$CONFIG";say "$G" '配置格式已修复（已为含空格的值补上引号）。';else say "$G" '配置格式正常，无需修复。';fi
 rm -f "$tmp" "$flag"
}
setval(){ k=$1;v=$2;if grep -q "^${k}=" "$CONFIG";then sed -i "s|^${k}=.*|${k}=\"${v}\"|" "$CONFIG";else printf '%s="%s"\n' "$k" "$v">>"$CONFIG";fi;}
migrate_defaults(){
 load
 cur=${AUTO_ACTION_PROTECTED_CMDLINE:-}
 if [ -n "$cur" ] && [ "$cur" != "$BASE_CMDLINE" ];then
  if [ "$cur" = "$LEGACY_CMDLINE_1" ];then
   setval AUTO_ACTION_PROTECTED_CMDLINE "$BASE_CMDLINE"
   say "$G" '命令豁免名单为历史默认值，已更新为当前收窄后的默认值。'
  else
   say "$G" '命令豁免名单为自定义内容，保持不变。'
  fi
 fi
 if [ -z "${AUTO_ACTION_PROTECTED_CONTAINERS:-}" ];then
  setval AUTO_ACTION_PROTECTED_CONTAINERS "$BASE_CONTAINERS"
  say "$G" '已补充容器豁免名单默认值。'
 fi
 chmod 600 "$CONFIG"
}
mask(){ v=$1;[ -z "$v" ]&&{ printf '未配置';return;};if [ ${#v} -le 8 ];then printf '********';else printf '%s…%s' "$(printf %s "$v"|cut -c1-6)" "$(printf %s "$v"|rev|cut -c1-4|rev)";fi;}
yn(){ [ "${1:-false}" = true ]&&printf '已授权' || printf '未授权';}
pause_back(){ ask "$G" '按回车或输入 F 返回上一级；输入 0 退出：';[ "$REPLY" = 0 ]&&return 20;return 0;}
check(){ load;/usr/bin/python3 /opt/vps-monitor/vps_monitor.py check;}
show_config(){
 load;printf '\n'
 say "$G" '========== Telegram 通知 =========='
 printf 'Bot Token：%s\n' "$(mask "${TG_BOT_TOKEN:-}")"
 printf 'Chat ID：%s\n' "${TG_CHAT_ID:-未配置}"
 printf '群组话题 ID：%s\n' "${TG_MESSAGE_THREAD_ID:-未配置}"
 printf '通知方式：%s\n' "$([ "${TG_DISABLE_NOTIFICATION:-false}" = true ]&&echo 静默||echo 声音/振动)"
 say "$G" '---------- 监控阈值 ----------'
 printf 'CPU 阈值：%s%%\n' "${CPU_THRESHOLD:-90}"
 printf '内存阈值：%s%%\n' "${MEMORY_THRESHOLD:-90}"
 printf 'Swap 阈值：%s%%\n' "${SWAP_THRESHOLD:-90}"
 printf '磁盘 I/O 阈值：%s%%\n' "${DISK_IO_THRESHOLD:-90}"
 printf '磁盘空间阈值：%s%%\n' "${DISK_SPACE_THRESHOLD:-90}"
 printf 'inode 阈值：%s%%\n' "${INODE_THRESHOLD:-90}"
 say "$Y" '---------- 取证权限 ----------'
 printf '取证模式：%s\n' "${FORENSICS_MODE:-basic}"
 printf 'FULL 授权：%s\n' "${FORENSICS_CONSENT:-NO}"
 say "$R" '---------- 自动处置权限 ----------'
 printf '自动处置总开关：%s\n' "${AUTO_ACTION:-none}"
 printf '自动处置总授权：%s\n' "${AUTO_ACTION_CONSENT:-NO}"
 printf 'CPU 自动处置：%s\n' "$(yn "${AUTO_ACTION_CPU:-false}")"
 printf '内存自动处置：%s\n' "$(yn "${AUTO_ACTION_MEMORY:-false}")"
 printf '磁盘读取自动处置：%s\n' "$(yn "${AUTO_ACTION_DISK_READ:-false}")"
 printf '磁盘写入自动处置：%s\n' "$(yn "${AUTO_ACTION_DISK_WRITE:-false}")"
 printf 'SIGKILL 强杀：%s\n' "$(yn "${AUTO_ACTION_ALLOW_SIGKILL:-false}")"
 say "$G" '---------- 自动处置豁免名单 ----------'
 printf '受保护程序名：%s\n' "${AUTO_ACTION_PROTECTED_NAMES:-默认系统与数据库}"
 printf '受保护命令关键字：%s\n' "${AUTO_ACTION_PROTECTED_CMDLINE:-默认构建与维护任务}"
 printf '受保护容器/镜像：%s\n' "${AUTO_ACTION_PROTECTED_CONTAINERS:-alist-tvbox,xiaoya-tvbox}"
 say "$G" '---------- 自身资源限制 ----------'
 printf 'RSS 主动退出线：%s MiB\n' "${SELF_RSS_MAX_MB:-80}"
 printf '单份报告上限：%s MiB\n' "${MAX_REPORT_SIZE_MB:-5}"
 printf '采样超时警告线：%s 秒\n' "${SELF_SAMPLE_TIMEOUT:-30}"
}
disable_all(){ setval AUTO_ACTION none;setval AUTO_ACTION_CONSENT NO;setval AUTO_ACTION_CPU false;setval AUTO_ACTION_MEMORY false;setval AUTO_ACTION_DISK_READ false;setval AUTO_ACTION_DISK_WRITE false;setval AUTO_ACTION_ALLOW_SIGKILL false;setval AUTO_ACTION_SIGKILL_CONSENT NO;}
enable_standard(){ setval FORENSICS_MODE full;setval FORENSICS_CONSENT YES;setval AUTO_ACTION terminate;setval AUTO_ACTION_CONSENT YES;setval AUTO_ACTION_CPU true;setval AUTO_ACTION_MEMORY true;setval AUTO_ACTION_DISK_READ true;setval AUTO_ACTION_DISK_WRITE true;setval AUTO_ACTION_ALLOW_SIGKILL false;setval AUTO_ACTION_SIGKILL_CONSENT NO;}
action_menu(){ need_root
 while :;do load;printf '\n';say "$R" '自动处置权限（高危）';say "$G" '1. 查看当前自动处置权限';say "$R" '2. 一键开启全部标准授权（FULL + 四类 + SIGTERM）';say "$R" '3. 单独授权或取消各资源类别';say "$R" '4. 单独授权 SIGKILL';say "$G" '5. 一键关闭全部自动处置授权';say "$G" '6. 管理构建任务豁免名单';say "$G" 'F. 返回上一级菜单';say "$G" '0. 退出脚本';ask "$G" '请选择：'
  case "$REPLY" in
   1)show_config;pause_back||return 20;;
   2)if [ -z "${TG_BOT_TOKEN:-}" ]||[ -z "${TG_CHAT_ID:-}" ];then say "$R" '禁止：请先配置并测试 Telegram。';else say "$R" '将开启 FULL 取证及 CPU/内存/磁盘读写 SIGTERM 自动处置。';say "$Y" '不会开启 SIGKILL；数据库、SSH 和系统进程仍受保护。';ask "$R" '同意请输入大写 YES：';if [ "$REPLY" = YES ];then enable_standard;chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";say "$R" '全部标准授权已开启。';else say "$R" '未授权，不修改。';fi;fi;;
   3)if [ "${FORENSICS_MODE:-basic}" != full ];then say "$R" '请先选择 2 开启 FULL 与标准授权，再逐项关闭。';else ask "$Y" 'CPU处置 [y/N]：';case "$REPLY" in y|Y)setval AUTO_ACTION_CPU true;;*)setval AUTO_ACTION_CPU false;;esac;ask "$Y" '内存处置 [y/N]：';case "$REPLY" in y|Y)setval AUTO_ACTION_MEMORY true;;*)setval AUTO_ACTION_MEMORY false;;esac;ask "$Y" '磁盘读取处置 [y/N]：';case "$REPLY" in y|Y)setval AUTO_ACTION_DISK_READ true;;*)setval AUTO_ACTION_DISK_READ false;;esac;ask "$Y" '磁盘写入处置 [y/N]：';case "$REPLY" in y|Y)setval AUTO_ACTION_DISK_WRITE true;;*)setval AUTO_ACTION_DISK_WRITE false;;esac;if grep -Eq '^AUTO_ACTION_(CPU|MEMORY|DISK_READ|DISK_WRITE)=true' "$CONFIG";then setval AUTO_ACTION terminate;setval AUTO_ACTION_CONSENT YES;else disable_all;fi;chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";say "$G" '逐项权限已保存。';fi;;
   4)say "$R" 'SIGKILL 会强制终止进程，可能损坏数据。';ask "$R" '授权请输入大写 KILL；输入 OFF 关闭：';case "$REPLY" in KILL)setval AUTO_ACTION_ALLOW_SIGKILL true;setval AUTO_ACTION_SIGKILL_CONSENT YES;say "$R" 'SIGKILL 已授权。';;OFF)setval AUTO_ACTION_ALLOW_SIGKILL false;setval AUTO_ACTION_SIGKILL_CONSENT NO;say "$G" 'SIGKILL 已关闭。';;*)say "$R" '未授权，不修改。';;esac;chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";;
   5)ask "$G" '确认关闭全部自动处置？输入 YES：';if [ "$REPLY" = YES ];then disable_all;chmod 600 "$CONFIG";systemctl restart "$SERVICE";say "$G" '全部自动处置已关闭。';else say "$G" '未确认，不修改。';fi;;
   6)printf '\n';say "$G" '当前豁免命令关键字：';printf '%s\n' "${AUTO_ACTION_PROTECTED_CMDLINE:-未设置}";printf '\n';say "$G" '命令行包含这些关键字的进程只告警，不会被自动处置。';ask "$G" '输入要追加的关键字（如 my-build）；回车跳过：';if [ -n "$REPLY" ];then addcmd "$REPLY";chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";say "$G" '豁免名单已更新。';fi;;
   F|f|'')return 0;;0)return 20;;*)say "$R" '无效选项，仍停留在当前菜单。';;
  esac
 done
}
configure(){ need_root
 while :;do load;printf '\n';say "$G" '修改现有配置和权限';say "$G" '1. Telegram 配置';say "$G" '2. 通知声音/静默';say "$Y" '3. BASIC/FULL 取证权限';say "$R" '4. 自动处置权限';say "$G" '5. 资源阈值';say "$Y" '6. 容器内存限制';say "$G" '7. 查看全部配置和权限';say "$G" 'F. 返回上一级菜单';say "$G" '0. 退出脚本';ask "$G" '请选择：'
  case "$REPLY" in
   1)ask "$G" 'Bot Token（回车不改，CLEAR清空）：';if [ -n "$REPLY" ];then if [ "$REPLY" = CLEAR ];then setval TG_BOT_TOKEN '';else setval TG_BOT_TOKEN "$REPLY";fi;fi;ask "$G" 'Chat ID（回车不改，CLEAR清空）：';if [ -n "$REPLY" ];then if [ "$REPLY" = CLEAR ];then setval TG_CHAT_ID '';else setval TG_CHAT_ID "$REPLY";fi;fi;ask "$G" '话题 ID（回车不改，CLEAR清空）：';if [ -n "$REPLY" ];then if [ "$REPLY" = CLEAR ];then setval TG_MESSAGE_THREAD_ID '';else setval TG_MESSAGE_THREAD_ID "$REPLY";fi;fi;;
   2)ask "$G" '1. 正常提醒  2. 静默  F.返回：';case "$REPLY" in 1)setval TG_DISABLE_NOTIFICATION false;;2)setval TG_DISABLE_NOTIFICATION true;;esac;;
   3)ask "$Y" '1. BASIC低危  2. FULL高危  F.返回：';case "$REPLY" in 1)setval FORENSICS_MODE basic;setval FORENSICS_CONSENT NO;disable_all;;2)say "$R" 'FULL 以 root 读取进程路径、端口和日志并发 TG。';ask "$R" '同意请输入 YES：';if [ "$REPLY" = YES ];then setval FORENSICS_MODE full;setval FORENSICS_CONSENT YES;else say "$R" '未授权。';fi;;esac;;
   4)action_menu||return 20;;
   5)ask "$G" 'CPU阈值：';setval CPU_THRESHOLD "$REPLY";ask "$G" '内存阈值：';setval MEMORY_THRESHOLD "$REPLY";ask "$G" '磁盘I/O阈值：';setval DISK_IO_THRESHOLD "$REPLY";;
   6)containers||return 20;;
   7)show_config;pause_back||return 20;;F|f|'')chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";return 0;;0)return 20;;*)say "$R" '无效选项，仍停留在当前菜单。';;
  esac
 done
}
containers(){
 if ! command -v docker >/dev/null 2>&1;then say "$Y" '未检测到 docker，跳过。';return 0;fi
 while :;do
  printf '\n';say "$G" '容器内存限制'
  printf '%-22s %-12s %-10s\n' 名称 已用 上限
  docker ps --format '{{.Names}}' | while IFS= read -r n;do
   [ -n "$n" ]||continue
   lim=$(docker inspect "$n" --format '{{.HostConfig.Memory}}' 2>/dev/null||echo 0)
   use=$(docker stats --no-stream --format '{{.MemUsage}}' "$n" 2>/dev/null|cut -d/ -f1|tr -d ' ')
   if [ "${lim:-0}" = 0 ];then txt='未限制';else txt="$(( lim / 1048576 ))MiB";fi
   printf '%-22s %-12s %-10s\n' "$n" "${use:-?}" "$txt"
  done
  printf '\n';say "$Y" '未限制的容器可耗尽整机内存，导致内核 OOM 杀掉其它服务。'
  say "$G" '1. 为某个容器设置内存上限'
  say "$G" '2. 取消某个容器的内存上限'
  say "$G" 'F. 返回上一级菜单'
  say "$G" '0. 退出脚本'
  ask "$G" '请选择：'
  case "$REPLY" in
   1) ask "$G" '容器名称：';cn=$REPLY;[ -n "$cn" ]||continue
      ask "$G" '内存上限（如 1400m 或 512m）：';ml=$REPLY;[ -n "$ml" ]||continue
      say "$Y" "将对 $cn 设置上限 $ml；超限时该容器内进程会被内核终止，容器可能重启。"
      ask "$Y" '确认请输入 YES：'
      if [ "$REPLY" = YES ];then
       if docker update --memory "$ml" --memory-swap "$ml" "$cn";then say "$G" "已设置 $cn 上限 $ml。";say "$Y" '注意：用 compose 重建容器会丢失该设置，需写入 compose 文件。';else say "$R" '设置失败，请检查容器名称与 Docker 版本。';fi
      else say "$G" '未确认，不修改。';fi;;
   2) ask "$G" '容器名称：';cn=$REPLY;[ -n "$cn" ]||continue
      ask "$Y" "取消 $cn 的内存上限会让它可占用整机内存。确认请输入 YES："
      if [ "$REPLY" = YES ];then
       if docker update --memory 0 --memory-swap 0 "$cn";then say "$G" '已取消上限。';else say "$R" '操作失败。';fi
      else say "$G" '未确认，不修改。';fi;;
   F|f|'') return 0;;
   0) return 20;;
   *) say "$R" '无效选项，仍停留在当前菜单。';;
  esac
 done
}
usage(){ echo '命令：status|logs|show-config|configure|authorize-actions|disable-actions|containers|set|allow|allow-container|show-allow|reset-allow|repair|test|restart|reports|actions|version|delete-log|uninstall';}
case "${1:-}" in status)systemctl status "$SERVICE" --no-pager --full;;logs)tail -n "${2:-10}" "$RUNTIME" 2>/dev/null||echo '暂无脚本进程日志。';;show-config)show_config;;configure|config)configure;;authorize-actions)action_menu;;disable-actions)need_root;disable_all;chmod 600 "$CONFIG";systemctl restart "$SERVICE";say "$G" '全部自动处置已关闭。';;check)check;;repair)repair;;migrate)need_root;migrate_defaults;;containers)containers;;reset-allow)need_root;setval AUTO_ACTION_PROTECTED_CMDLINE "$BASE_CMDLINE";setval AUTO_ACTION_PROTECTED_CONTAINERS "$BASE_CONTAINERS";chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";say "$G" '命令与容器豁免名单均已恢复为默认值。';;set)need_root;if [ -z "${2:-}" ]||[ -z "${3:-}" ];then say "$R" '用法：vps-monitorctl set 键 值';exit 1;fi;setval "$2" "$3";chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";say "$G" "已设置 $2=$3";;allow)need_root;load;if [ -z "${2:-}" ];then say "$R" '用法：vps-monitorctl allow 命令关键字';exit 1;fi;addcmd "$2";chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";say "$G" "已加入命令豁免名单：$2";;
allow-container)need_root;load;if [ -z "${2:-}" ];then say "$R" '用法：vps-monitorctl allow-container 容器名或镜像关键字';exit 1;fi;addct "$2";chmod 600 "$CONFIG";check&&systemctl restart "$SERVICE";say "$G" "已加入容器豁免名单：$2";;
show-allow)load;printf '\n';say "$G" '命令关键字豁免：';printf '%s\n' "${AUTO_ACTION_PROTECTED_CMDLINE:-$BASE_CMDLINE}";printf '\n';say "$G" '容器/镜像豁免：';printf '%s\n' "${AUTO_ACTION_PROTECTED_CONTAINERS:-$BASE_CONTAINERS}";printf '\n';say "$G" '受保护程序名：';printf '%s\n' "${AUTO_ACTION_PROTECTED_NAMES:-默认系统与数据库}";;test)load;/usr/bin/python3 /opt/vps-monitor/vps_monitor.py test-telegram;;restart)need_root;systemctl restart "$SERVICE";systemctl status "$SERVICE" --no-pager --full;;reports)ls -lht "$DATA/reports" 2>/dev/null||echo '暂无报告。';;actions)tail -n 20 "$DATA/actions.jsonl" 2>/dev/null||echo '暂无处置记录。';;version)/usr/bin/python3 /opt/vps-monitor/vps_monitor.py version;;delete-log)need_root;say "$R" '将删除专用脚本日志，不影响处置审计和系统 journal。';ask "$R" '输入 DELETE 确认：';if [ "$REPLY" = DELETE ];then :>"$RUNTIME";say "$G" '日志已清空。';else say "$R" '未授权。';fi;;uninstall)need_root;systemctl disable --now "$SERVICE"||true;rm -f /etc/systemd/system/vps-monitor.service /usr/local/bin/vps-monitorctl /usr/local/bin/vps /usr/local/bin/vps-build-mode;rm -rf /opt/vps-monitor;systemctl daemon-reload;echo '程序和 vps 快捷命令已卸载；配置和数据保留。';;*)usage;exit 1;;esac
