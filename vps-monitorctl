#!/bin/sh
set -eu
SERVICE=vps-monitor;CONFIG=/etc/vps-monitor.env;TTY=/dev/tty
if [ -t 1 ];then B='\033[1;34m';Y='\033[1;33m';R='\033[1;31m';G='\033[1;32m';N='\033[0m';else B=;Y=;R=;G=;N=;fi
say(){ printf '%b%s%b\n' "$1" "$2" "$N";};ask(){ printf '%b%s%b' "$1" "$2" "$N">"$TTY";IFS= read -r REPLY<"$TTY"||REPLY=;}
usage(){ cat <<'EOF'
用法：vps-monitorctl 命令
 status状态  logs日志  config编辑配置  set修改变量  check检查配置
 test测试TG  restart重启  reports报告  actions处置记录  version版本
 authorize-actions授权自动处置  disable-actions关闭自动处置  uninstall卸载
EOF
}
need_root(){ [ "$(id -u)" = 0 ]||{ echo '请使用 sudo';exit 1;};}
load(){ set -a;
 # shellcheck disable=SC1090
 . "$CONFIG"
 set +a;}
check(){ load;/usr/bin/python3 /opt/vps-monitor/vps_monitor.py check;}
setval(){ k=$1;v=$2;if grep -q "^${k}=" "$CONFIG";then sed -i "s|^${k}=.*|${k}=${v}|" "$CONFIG";else printf '%s=%s\n' "$k" "$v">>"$CONFIG";fi;}
maybe_backup(){ ask "$B" '是否备份当前配置？输入 Y 备份 [y/N]：';case "$REPLY" in Y|y) BACKUP="$CONFIG.backup.$(date +%Y%m%d-%H%M%S)";cp -p "$CONFIG" "$BACKUP";say "$G" "已授权备份：$BACKUP";;*) BACKUP=;say "$B" '未授权备份：不创建备份。';;esac;}
case "${1:-}" in
 status) systemctl status "$SERVICE" --no-pager --full;;
 logs) journalctl -u "$SERVICE" -f -o cat;;
 config) need_root;maybe_backup;${EDITOR:-nano} "$CONFIG";chmod 600 "$CONFIG";if check;then systemctl restart "$SERVICE";say "$G" '配置有效，服务已重启。';else say "$R" '配置无效，服务未重启。请重新编辑修复。';exit 1;fi;;
 set) need_root;[ "$#" = 3 ]||{ usage;exit 1;};echo "$2"|grep -Eq '^[A-Z][A-Z0-9_]*$'||{ echo '变量名无效';exit 1;};maybe_backup;setval "$2" "$3";chmod 600 "$CONFIG";if check;then systemctl restart "$SERVICE";say "$G" "已更新 $2 并重启。";else say "$R" '配置无效，服务未重启。';exit 1;fi;;
 authorize-actions)
  need_root;load
  if [ "${FORENSICS_MODE:-basic}" != full ]||[ "${FORENSICS_CONSENT:-NO}" != YES ];then say "$R" '禁止：自动处置必须先通过安装器授权 FULL 取证。';exit 2;fi
  if [ -z "${TG_BOT_TOKEN:-}" ]||[ -z "${TG_CHAT_ID:-}" ];then say "$R" '禁止：必须先配置并测试 Telegram。';exit 2;fi
  say "$R" '高危：将对连续确认的异常主因发送 SIGTERM，可能中断服务或造成数据损失。'
  say "$Y" '数据库、SSH、系统进程默认保护；每次动作写日志并发送 TG。'
  ask "$R" '同意启用请输入大写 YES：';[ "$REPLY" = YES ]||{ say "$R" '未授权，不做任何修改。';exit 2;}
  ask "$Y" '授权 CPU 异常处置？[y/N]：';case "$REPLY" in Y|y) ac=true;;*)ac=false;;esac
  ask "$Y" '授权内存异常处置？[y/N]：';case "$REPLY" in Y|y) am=true;;*)am=false;;esac
  ask "$Y" '授权磁盘读取异常处置？[y/N]：';case "$REPLY" in Y|y) ar=true;;*)ar=false;;esac
  ask "$Y" '授权磁盘写入异常处置？[y/N]：';case "$REPLY" in Y|y) aw=true;;*)aw=false;;esac
  [ "$ac$am$ar$aw" != falsefalsefalsefalse ]||{ say "$R" '未授权任何类别，不做修改。';exit 2;}
  ask "$R" 'SIGTERM 超时后允许强制 SIGKILL？高危，输入 KILL 同意 [默认禁止]：';case "$REPLY" in KILL)ak=true;akc=YES;;*)ak=false;akc=NO;;esac
  maybe_backup
  setval AUTO_ACTION terminate;setval AUTO_ACTION_CONSENT YES;setval AUTO_ACTION_CPU "$ac";setval AUTO_ACTION_MEMORY "$am";setval AUTO_ACTION_DISK_READ "$ar";setval AUTO_ACTION_DISK_WRITE "$aw";setval AUTO_ACTION_ALLOW_SIGKILL "$ak";setval AUTO_ACTION_SIGKILL_CONSENT "$akc";chmod 600 "$CONFIG"
  check;systemctl restart "$SERVICE";say "$R" '自动处置已按所选类别启用。请运行 vps-monitorctl check 复核。';;
 disable-actions) need_root;setval AUTO_ACTION none;setval AUTO_ACTION_CONSENT NO;setval AUTO_ACTION_ALLOW_SIGKILL false;setval AUTO_ACTION_SIGKILL_CONSENT NO;chmod 600 "$CONFIG";systemctl restart "$SERVICE";say "$G" '自动处置已关闭。';;
 check) check;;test) load;/usr/bin/python3 /opt/vps-monitor/vps_monitor.py test-telegram;;restart) need_root;systemctl restart "$SERVICE";systemctl status "$SERVICE" --no-pager --full;;reports) ls -lht /var/lib/vps-monitor/reports 2>/dev/null||echo '暂无异常报告。';;actions) ls -lh /var/lib/vps-monitor/actions.jsonl 2>/dev/null&&tail -n 20 /var/lib/vps-monitor/actions.jsonl||echo '暂无自动处置记录。';;version) /usr/bin/python3 /opt/vps-monitor/vps_monitor.py version;;
 uninstall) need_root;systemctl disable --now "$SERVICE"||true;rm -f /etc/systemd/system/vps-monitor.service /usr/local/bin/vps-monitorctl;rm -rf /opt/vps-monitor;systemctl daemon-reload;echo '程序已卸载；配置和历史数据已保留。';;
 *) usage;exit 1;;esac
