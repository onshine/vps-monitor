# VPS Sentinel 配置。修改后：sudo vps-monitorctl restart
# Telegram：@BotFather 创建机器人；给机器人/群发消息后，从 getUpdates 读取 chat.id
TG_BOT_TOKEN=
TG_CHAT_ID=
# TG_MESSAGE_THREAD_ID=
TG_DISABLE_NOTIFICATION=false

# 权限模式：basic 只收集整机统计；full 会读取其他进程路径/fd/端口及系统日志。
# 使用 full 前必须阅读 SECURITY.md；安装器要求手输大写 YES。
FORENSICS_MODE=basic
FORENSICS_CONSENT=NO
# 程序内部预算（外部另有 systemd/Docker 硬限制）
SELF_RSS_MAX_MB=80
SELF_SAMPLE_TIMEOUT=30
MAX_REPORT_SIZE_MB=5

MONITOR_INTERVAL=5
PROCESS_SCAN_INTERVAL=5
CPU_THRESHOLD=90
MEMORY_THRESHOLD=90
SWAP_THRESHOLD=90
DISK_IO_THRESHOLD=90
DISK_SPACE_THRESHOLD=90
INODE_THRESHOLD=90
# 可选绝对吞吐阈值；0 表示禁用
DISK_READ_MBPS=0
DISK_WRITE_MBPS=0
ALERT_CONSECUTIVE=2
RECOVERY_CONSECUTIVE=3
ALERT_COOLDOWN=900
TOP_PROCESSES=15
MAX_FDS_PER_PROCESS=150

MONITOR_DATA_DIR=/var/lib/vps-monitor
REPORT_RETENTION_DAYS=14
REPORT_MAX_FILES=100
# JSONL 历史指标；设为 0 禁用
METRICS_INTERVAL=60
METRICS_RETENTION_DAYS=7
# MONITOR_HOSTNAME=my-vps
