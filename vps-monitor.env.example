# VPS Monitor 配置文件
# 修改并保存：sudo vps-monitorctl config
# 测试 Telegram：sudo vps-monitorctl test

# ───────────── Telegram 通知 ─────────────
# 必填：@BotFather 提供的机器人 Token。请勿发给他人或提交到 Git。
TG_BOT_TOKEN=""
# 必填：接收通知的私聊/群组 ID；群组 ID 通常以 -100 开头。
TG_CHAT_ID=""
# 可选：Telegram 群开启“话题/Topics”后，指定通知发到哪个话题。
# 普通私聊、普通群或不指定话题时保持空白。
TG_MESSAGE_THREAD_ID=""
# false=正常通知（有声音/振动）；true=静默通知。建议告警保持 false。
TG_DISABLE_NOTIFICATION="false"

# ───────────── 构建/维护任务白名单 ─────────────
# 命令行包含以下任一关键字的进程，永不被自动处置（仅告警取证）。
# 适合前端构建、编译、包管理、备份、解压等短时高负载任务。
# 英文逗号分隔，匹配不区分大小写；可自行追加自己的构建命令。
AUTO_ACTION_PROTECTED_CMDLINE="vite build,npm run build,npm install,npm ci,docker build,apt-get,dpkg,mysqldump"

# ───────────── 权限模式 ─────────────
# basic=只监控整机；full=读取其他进程的路径/fd/端口/日志（高危）。
FORENSICS_MODE="basic"
# FULL 必须是 YES，且应通过安装器明确授权；不要只手工改这一项。
FORENSICS_CONSENT="NO"

# ───────────── 采样和告警阈值 ─────────────
# 整机采样间隔（秒）。
MONITOR_INTERVAL="5"
# FULL 模式扫描进程 I/O 的间隔（秒）。
PROCESS_SCAN_INTERVAL="5"
# 百分比阈值：达到后进入连续命中判断。
CPU_THRESHOLD="90"
MEMORY_THRESHOLD="90"
# 内存/Swap 需连续超限达到该秒数才告警，避免前端构建等短时冲高误报。
MEMORY_SUSTAIN_SECONDS="120"
# 报告与通知中自动隐藏疑似 Token/密钥/密码，替换为 [REDACTED]。
REDACT_SECRETS="true"
SWAP_THRESHOLD="90"
DISK_IO_THRESHOLD="90"
DISK_SPACE_THRESHOLD="90"
INODE_THRESHOLD="90"
# 可选绝对磁盘吞吐阈值（MiB/s）；0=禁用。
DISK_READ_MBPS="0"
DISK_WRITE_MBPS="0"
# 连续命中多少次才告警；恢复连续次数；重复告警冷却秒数。
ALERT_CONSECUTIVE="2"
RECOVERY_CONSECUTIVE="3"
ALERT_COOLDOWN="900"
# 报告中最多取证多少个进程、每个进程最多记录多少个 fd。
TOP_PROCESSES="15"
MAX_FDS_PER_PROCESS="150"

# ───────────── 自动处置安全边界（高危） ─────────────
# none=只告警；terminate=仅对已授权类别的明确主因发送 SIGTERM。
AUTO_ACTION="none"
# 必须通过安装器二次红色授权写为 YES；未授权保持 NO。
AUTO_ACTION_CONSENT="NO"
# 逐项授权：未设为 true 的异常类别绝不处置。
AUTO_ACTION_CPU="false"
AUTO_ACTION_MEMORY="false"
AUTO_ACTION_DISK_READ="false"
AUTO_ACTION_DISK_WRITE="false"
# 强杀风险极高，默认禁止；两个值都明确授权才可能在 SIGTERM 超时后 SIGKILL。
AUTO_ACTION_ALLOW_SIGKILL="false"
AUTO_ACTION_SIGKILL_CONSENT="NO"
# 同一 PID（含启动时间）连续确认次数、SIGTERM 宽限秒数、每小时最多动作次数。
AUTO_ACTION_CONSECUTIVE="3"
# 先降级后终止：默认先限速/冻结（可恢复），持续不缓解才终止。
AUTO_ACTION_THROTTLE_FIRST="true"
# 降级时是否使用 SIGSTOP 冻结进程（可用 kill -CONT 恢复）。
AUTO_ACTION_THROTTLE_FREEZE="true"
# 降级后再连续确认多少次仍异常才升级为终止；0 表示永不升级。
AUTO_ACTION_ESCALATE_AFTER="6"
AUTO_ACTION_GRACE_SECONDS="10"
AUTO_ACTION_MAX_PER_HOUR="3"
# 进程自身最低贡献，避免整机异常时处置贡献很小的进程。
AUTO_ACTION_PROCESS_CPU_MIN="70"
AUTO_ACTION_PROCESS_MEMORY_MIN="25"
AUTO_ACTION_PROCESS_READ_MBPS_MIN="10"
AUTO_ACTION_PROCESS_WRITE_MBPS_MIN="10"
# 永不处置的程序名，可按需追加，英文逗号分隔。
AUTO_ACTION_PROTECTED_NAMES="systemd,sshd,ssh,init,kthreadd,kworker,rcu_sched,systemd-journal,systemd-udevd,dbus-daemon,cron,containerd,dockerd,mysqld,mariadbd,postgres,redis-server,mongod"
# 每次动作追加到 /var/lib/vps-monitor/actions.jsonl；超过 100MiB 只通知，不自动删除。

# ───────────── 监控器自身预算 ─────────────
# 内部 RSS 退出线（MiB）；外部 systemd 硬上限另为 96MiB。
SELF_RSS_MAX_MB="80"
# 单次采样耗时警告线（秒）；单份报告最大值（MiB）。
SELF_SAMPLE_TIMEOUT="30"
MAX_REPORT_SIZE_MB="5"

# ───────────── 数据保留 ─────────────
MONITOR_DATA_DIR="/var/lib/vps-monitor"
REPORT_RETENTION_DAYS="14"
REPORT_MAX_FILES="100"
# JSONL 历史指标写入间隔（秒），0=禁用；以及保留天数。
METRICS_INTERVAL="60"
METRICS_RETENTION_DAYS="7"
# 可选：通知中显示的主机名；留空使用系统 hostname。
MONITOR_HOSTNAME=""
