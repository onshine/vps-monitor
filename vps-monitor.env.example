# VPS Monitor 配置文件
# 修改并保存：sudo vps-monitorctl config
# 测试 Telegram：sudo vps-monitorctl test

# ───────────── Telegram 通知 ─────────────
# 必填：@BotFather 提供的机器人 Token。请勿发给他人或提交到 Git。
TG_BOT_TOKEN=
# 必填：接收通知的私聊/群组 ID；群组 ID 通常以 -100 开头。
TG_CHAT_ID=
# 可选：Telegram 群开启“话题/Topics”后，指定通知发到哪个话题。
# 普通私聊、普通群或不指定话题时保持空白。
TG_MESSAGE_THREAD_ID=
# false=正常通知（有声音/振动）；true=静默通知。建议告警保持 false。
TG_DISABLE_NOTIFICATION=false

# ───────────── 权限模式 ─────────────
# basic=只监控整机；full=读取其他进程的路径/fd/端口/日志（高危）。
FORENSICS_MODE=basic
# FULL 必须是 YES，且应通过安装器明确授权；不要只手工改这一项。
FORENSICS_CONSENT=NO

# ───────────── 采样和告警阈值 ─────────────
# 整机采样间隔（秒）。
MONITOR_INTERVAL=5
# FULL 模式扫描进程 I/O 的间隔（秒）。
PROCESS_SCAN_INTERVAL=5
# 百分比阈值：达到后进入连续命中判断。
CPU_THRESHOLD=90
MEMORY_THRESHOLD=90
SWAP_THRESHOLD=90
DISK_IO_THRESHOLD=90
DISK_SPACE_THRESHOLD=90
INODE_THRESHOLD=90
# 可选绝对磁盘吞吐阈值（MiB/s）；0=禁用。
DISK_READ_MBPS=0
DISK_WRITE_MBPS=0
# 连续命中多少次才告警；恢复连续次数；重复告警冷却秒数。
ALERT_CONSECUTIVE=2
RECOVERY_CONSECUTIVE=3
ALERT_COOLDOWN=900
# 报告中最多取证多少个进程、每个进程最多记录多少个 fd。
TOP_PROCESSES=15
MAX_FDS_PER_PROCESS=150

# ───────────── 自动处置安全边界 ─────────────
# 当前版本只监控、取证、通知，绝不自动 STOP/KILL/限速/重启任何业务进程。
# 未经用户针对目标和动作的额外明确授权，任何自动处置都被禁止。
AUTO_ACTION=none
AUTO_ACTION_CONSENT=NO

# ───────────── 监控器自身预算 ─────────────
# 内部 RSS 退出线（MiB）；外部 systemd 硬上限另为 96MiB。
SELF_RSS_MAX_MB=80
# 单次采样耗时警告线（秒）；单份报告最大值（MiB）。
SELF_SAMPLE_TIMEOUT=30
MAX_REPORT_SIZE_MB=5

# ───────────── 数据保留 ─────────────
MONITOR_DATA_DIR=/var/lib/vps-monitor
REPORT_RETENTION_DAYS=14
REPORT_MAX_FILES=100
# JSONL 历史指标写入间隔（秒），0=禁用；以及保留天数。
METRICS_INTERVAL=60
METRICS_RETENTION_DAYS=7
# 可选：通知中显示的主机名；留空使用系统 hostname。
MONITOR_HOSTNAME=
